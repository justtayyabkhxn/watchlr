# Copy to .env.local for local dev. On Cloudflare, set the secrets below as
# Secret-type variables in the dashboard (or `npx wrangler secret put NAME`).
# For `npm run preview` (local Workers runtime), put the same values in .dev.vars.

# --- Secrets ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
TMDB_API_KEY=your-tmdb-api-key
GROQ_API_KEY=your-groq-api-key
# Optional: enables live streaming availability (RapidAPI, Movie of the Night)
RAPIDAPI_KEY=

# --- Non-secret config ---
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Optional: canonical origin for metadata/sitemap (inlined at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: default streaming country (ISO 3166-1 alpha-2), defaults to "in"
STREAMING_REGION=in
# Optional: TMDB API proxy, tried before the official hosts
TMDB_API_BASE=
